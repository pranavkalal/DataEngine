# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account_identifier      # e.g. abc12345.us-east-1
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=your_database_name          # e.g. AUS_BANKING
SNOWFLAKE_WAREHOUSE=your_warehouse_name        # e.g. COMPUTE_WH
SNOWFLAKE_ROLE=your_role_name                  # e.g. TRANSFORMER

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
